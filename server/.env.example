# Copy to .env
PORT=4000
DATABASE_URL=postgres://radar:radar@localhost:5432/radar
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# The account with this email becomes an admin when it registers
ADMIN_EMAIL=you@example.com

# Where sample data is generated, where the map starts, and the area geocoding is limited to.
# Downtown London, Ontario.
CENTER_LAT=42.9849
CENTER_LNG=-81.2453

# Event times are London local time no matter where the server runs (cloud hosts default to UTC).
CITY_TIMEZONE=America/Toronto

# Pipeline
ENABLE_PIPELINE_CRON=false
PIPELINE_CRON=0 */6 * * *
# Nominatim asks for a contact in the User-Agent. Put your email here.
GEOCODER_CONTACT=you@example.com
